# The Adom LMS the website's forms post to. Defaults to the live LMS on Render.
# Set it to an empty value (VITE_LMS_URL=) to build in demo mode, where forms don't send anything.
VITE_LMS_URL=https://adom-lms-portal.onrender.com

# The website's own public address, used for canonical links and the sitemap.
VITE_SITE_URL=https://www.adomtechnologies.co.za
